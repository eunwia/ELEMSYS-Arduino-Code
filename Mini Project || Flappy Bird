#include <Wire.h>
#include <LiquidCrystal_I2C.h>

LiquidCrystal_I2C lcd(0x27, 16, 2);

int joystickPin = A0;
int buzzerPin = 3;
int redLed = 6;
int greenLed = 5;
int yellowLed = 4;

byte birdUp[8]   = {0b00000,0b00110,0b01111,0b11111,0b01110,0b00000,0b00000,0b00000};
byte birdDown[8] = {0b00000,0b00000,0b00000,0b01110,0b11111,0b01111,0b00110,0b00000};
byte pipeChar[8] = {0b11111,0b11111,0b11111,0b11111,0b11111,0b11111,0b11111,0b11111};

int birdRow = 1;
int lastBirdRow = -1;
int pipeCol = 15;
int lastPipeCol = -99;
int pipeGapRow = 0;
int score = 0;
bool gameOver = false;

unsigned long lastMoveTime = 0;
int moveInterval = 300;

void setup() {
  lcd.init();
  lcd.backlight();
  lcd.createChar(0, birdUp);
  lcd.createChar(1, birdDown);
  lcd.createChar(2, pipeChar);
  pinMode(joystickPin, INPUT);
  pinMode(buzzerPin, OUTPUT);
  pinMode(redLed, OUTPUT);
  pinMode(greenLed, OUTPUT);
  pinMode(yellowLed, OUTPUT);
  randomSeed(analogRead(A1));

  showStartScreen();
}

void setLeds(bool r, bool g, bool y) {
  digitalWrite(redLed, r ? HIGH : LOW);
  digitalWrite(greenLed, g ? HIGH : LOW);
  digitalWrite(yellowLed, y ? HIGH : LOW);
}

void showStartScreen() {
  setLeds(false, false, true); // yellow = idle, no actions yet

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Flappy Bird");
  lcd.setCursor(12, 0);
  lcd.write(byte(0));
  lcd.setCursor(3, 1);
  lcd.print("IOTIFY");
  delay(1500);

  lcd.clear();
  lcd.setCursor(2, 0);
  lcd.write(byte(0));
  lcd.setCursor(0, 1);
  lcd.print("Move UP to start");

  while (true) {
    int joyY = analogRead(joystickPin);
    if (joyY > 700) break;
  }

  birdRow = 1; lastBirdRow = -1;
  pipeCol = 15; lastPipeCol = -99;
  pipeGapRow = 0;
  score = 0;
  gameOver = false;
  lastMoveTime = millis();

  setLeds(false, true, false); // green = game ongoing

  lcd.clear();
  drawStaticDots();
}

void drawStaticDots() {
  for (int c = 0; c < 16; c++) {
    if (c != 2) {
      lcd.setCursor(c, 0);
      lcd.print(".");
    }
  }
}

void loop() {
  if (gameOver) {
    setLeds(true, false, false); // red = game over

    lcd.clear();
    lcd.print("Game Over!");
    lcd.setCursor(0, 1);
    lcd.print("Score: ");
    lcd.print(score);
    tone(buzzerPin, 200, 300);
    delay(2500);
    showStartScreen();
    return;
  }

  int joyY = analogRead(joystickPin);
  birdRow = (joyY > 700) ? 0 : 1;

  bool pipeMoved = false;
  if (millis() - lastMoveTime >= moveInterval) {
    lastMoveTime = millis();
    pipeCol--;
    pipeMoved = true;
    if (pipeCol < -1) {
      pipeCol = 15;
      pipeGapRow = random(0, 2);
    }
    if (pipeCol == 2 && birdRow != pipeGapRow) gameOver = true;
    if (pipeCol == 1) {
      score++;
      tone(buzzerPin, 1000, 100);
    }
  }

  if (birdRow != lastBirdRow || pipeMoved) {
    if (lastBirdRow != -1) {
      lcd.setCursor(2, lastBirdRow);
      lcd.print(lastBirdRow == 0 ? "." : " ");
    }
    if (lastPipeCol >= 0 && lastPipeCol < 16) {
      lcd.setCursor(lastPipeCol, 1 - pipeGapRow);
      lcd.print(" ");
    }

    lcd.setCursor(2, birdRow);
    lcd.write(birdRow == 0 ? byte(0) : byte(1));

    if (pipeCol >= 0 && pipeCol < 16) {
      lcd.setCursor(pipeCol, 1 - pipeGapRow);
      lcd.write(byte(2));
    }

    lastBirdRow = birdRow;
    lastPipeCol = pipeCol;
  }
}

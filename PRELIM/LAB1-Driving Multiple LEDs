int leds[] = {2,3,4,5,6,7,8,9,10};
int noOfLeds = 9;

void setup()
{
  for (int i = 0; i < noOfLeds; i++)
  {
	pinMode(leds[i], OUTPUT);	
  }
}

void loop()
{
  for (int i= 0; i < noOfLeds; i++)
  {
    digitalWrite(leds[i],HIGH);
    delay(100);
  }
  for (int i= 0; i < noOfLeds; i++)
  {
    digitalWrite(leds[i],LOW);
    delay(100);
  }
}

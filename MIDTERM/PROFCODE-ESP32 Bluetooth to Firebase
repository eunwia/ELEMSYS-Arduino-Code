#include <WiFi.h>
#include <BluetoothSerial.h>
#include <Firebase_ESP_Client.h>

BluetoothSerial SerialBT;

#define WIFI_SSID "HugotKing"
#define WIFI_PASSWORD "********"

#define API_KEY "*****"
#define DATABASE_URL "*****"

#define led1 23
FirebaseData fbdo;
FirebaseAuth auth;
FirebaseConfig config;

void setup() {

  Serial.begin(115200);

  // Bluetooth
  SerialBT.begin("ESP32_Control");
  Serial.println("Bluetooth Started");
  pinMode(led1, OUTPUT);
  digitalWrite(led1, LOW);
  // WiFi
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nWiFi Connected");

  // Firebase
  config.api_key = API_KEY;
  config.database_url = DATABASE_URL;

  if (Firebase.signUp(&config, &auth, "", "")) {
    Serial.println("Firebase SignUp OK");
  } else {
    Serial.println(config.signer.signupError.message.c_str());
  }

  Firebase.begin(&config, &auth);
  Firebase.reconnectWiFi(true);
}

void loop() {

  if (SerialBT.available() && Firebase.ready()) {

    char cmd = SerialBT.read();

    Serial.print("Received: ");
    Serial.println(cmd);

    if (cmd == '1') {

      Firebase.RTDB.setInt(&fbdo, "/led", 1);
      digitalWrite(led1, HIGH);
      Serial.println("LED = 1 uploaded");

    } else if (cmd == '0') {

      Firebase.RTDB.setInt(&fbdo, "/led", 0);
      digitalWrite(led1, LOW);
      Serial.println("LED = 0 uploaded");
    }
  }
}

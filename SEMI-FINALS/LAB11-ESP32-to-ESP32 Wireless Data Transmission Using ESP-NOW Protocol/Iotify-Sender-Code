#include <esp_now.h>
#include <WiFi.h>

uint8_t receiverMAC[] = {0x88, 0xF1, 0x55, 0x32, 0x65, 0xF8};

#define BUTTON 32
enum Direction : uint8_t { CENTER, UP, DOWN, LEFT, RIGHT, BLINK };

typedef struct {
  uint8_t dir;
} Message;
Message out;

bool lastBtn = HIGH;

void setup() {
  Serial.begin(115200);
  pinMode(BUTTON, INPUT_PULLUP);
  WiFi.mode(WIFI_STA);
  
  if (esp_now_init() != ESP_OK) {
  Serial.println("ESP-NOW init failed");
  return;
  }

  esp_now_peer_info_t peer = {};
  memcpy(peer.peer_addr, receiverMAC, 6);
  peer.channel = 0;
  peer.encrypt = false;
  if (esp_now_add_peer(&peer) != ESP_OK) {
  Serial.println("Add peer failed");
  return;
  }

  Serial.println("Sender ready");
}

void loop() {
  bool btn = digitalRead(BUTTON);
  if (lastBtn == HIGH && btn == LOW) {
    out.dir = BLINK;
    esp_err_t result = esp_now_send(receiverMAC, (uint8_t *)&out,
    sizeof(out));
    Serial.println(result == ESP_OK ? "Press sent" : "Send error");
  }
  lastBtn = btn;
  delay(20); 
}
